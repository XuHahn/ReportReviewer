# Text reasoning and structured extraction. Leave the key empty only when a
# local text endpoint is configured below.
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# Single evidence-graph review engine.
# hybrid: local Qwen vision plus DeepSeek text; local_only: both endpoints local.
UNIFIED_REVIEW_PROVIDER_MODE=hybrid
UNIFIED_REVIEW_VISION_BASE_URL=http://127.0.0.1:8081/v1
UNIFIED_REVIEW_VISION_MODEL=mlx-community/Qwen3-VL-8B-Instruct-4bit
UNIFIED_REVIEW_VISION_API_KEY=local-no-key
UNIFIED_REVIEW_VISION_MAX_TOKENS=6144
UNIFIED_REVIEW_VISION_MAX_KV_SIZE=12288
UNIFIED_REVIEW_VISION_PROMPT_RESERVE_TOKENS=6144
UNIFIED_REVIEW_VISION_CACHE_SIZE=2
STANDARD_VISION_CONCURRENCY=2
STANDARD_EMBEDDING_BACKEND=lexical-hash
UNIFIED_REVIEW_TEXT_BASE_URL=
UNIFIED_REVIEW_TEXT_MODEL=
UNIFIED_REVIEW_TEXT_API_KEY=local-no-key
UNIFIED_REVIEW_PREFLIGHT_TIMEOUT=5
UNIFIED_REVIEW_START_LOCAL_VISION=false
# Local Qwen-VL can take several minutes to load on first startup. start.sh
# starts it in the background; this value only bounds the launcher readiness
# milestone written to logs/qwen-vision.log and never blocks the API.
VISION_READY_TIMEOUT_SEC=600

# Native document unitization. Qwen vision is used only for scans, complex
# tables and targeted recovery after the native path cannot close evidence.
UNITIZER_MAX_RENDER_PAGES=1000
UNITIZER_RENDER_SCALE=2.0
DOCUMENT_PREVIEW_CACHE_DIR=
DOCUMENT_PREVIEW_CACHE_TTL_SECONDS=604800
DOCUMENT_PREVIEW_CACHE_MAX_BYTES=2147483648
OFFICE_FONTCONFIG=
ZIP_LEGACY_ENCODINGS=gb18030,big5,shift_jis
EVIDENCE_GRAPH_UNIT_CONCURRENCY=2

# Replace before production deployment.
JWT_SECRET=replace-with-a-long-random-secret
LOG_ENV=dev
DB_PATH=review.db

MAX_ZIP_FILES=2000
MAX_ZIP_UNCOMPRESSED_BYTES=1073741824
MAX_ZIP_COMPRESSION_RATIO=200
